<%= form_with(model: food, html: { class: "food-form" }) do |form| %>
  <div class="close-button">
   <%= yield if block_given? %>
  </div>
  <% if food.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(food.errors.count, "error") %> prohibited this food from being saved:</h2>
      <ul>
        <% food.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h1 class="form-title">Add Food</h1>
  
  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :measurement_unit, class: "form-label" %>
    <%= form.text_field :measurement_unit, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :price, class: "form-label" %>
    <%= form.text_field :price, class: "form-input" %>
  </div>

  <%= form.hidden_field :user_id, value: current_user.id %>

  <div class="form-group">
    <%= form.submit class: "form-submit" %>
  </div>
<% end %>