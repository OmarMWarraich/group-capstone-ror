<%= turbo_frame_tag dom_id(recipe), html: { class: "recipe-stats" } do %>
  <div>
    <p>
      <%= recipe.name %>
    </p>

    <p>
      <%= recipe.preparation_time %>
    </p>

    <p>
      <%= recipe.cooking_time %>
    </p>

    <p>
      <%= recipe.description %>
    </p>

    <p>
      <%= recipe.public %>
    </p>

    <p>
      <%= recipe.user_id %>
    </p>
  </div>
<% end %>