<%= form_with(model: recipe, local: true, id: dom_id(recipe), html: { class: "recipe-form-container" }) do |form| %>
  <% if recipe.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</h2>
      <ul>
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="upper-section">
    <%= form.text_area :description, placeholder: "Description", class: "recipe-input-description" %>
  </div>

  <div class="lower-section">
    <div class="recipe-placeholder">
      <%= form.text_field :name, placeholder: "Name" %>
    </div>

    <div class="recipe-placeholder">
      <%= form.text_field :preparation_time, placeholder: "Preparation Time" %>
    </div>

    <div class="recipe-placeholder">
      <%= form.text_field :cooking_time, placeholder: "Cooking Time" %>
    </div>


    <div>
      <%= form.check_box :public %>
    </div>

    <div class="hidden-field">
      <%= form.hidden_field :user_id, value: current_user.id %>
    </div>

    <div>
      <%= form.submit "Save Recipe", class: "large-button" %>
    </div>
  </div>
<% end %>